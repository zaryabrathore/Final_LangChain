# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Hosted Qdrant Vector Store Credentials
QDRANT_HOST=https://your-qdrant-instance.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=pdf_rag_collection

# GitHub API / MCP Configuration
GITHUB_TOKEN=your_github_token_here

# Google Workspace (Calendar & Gmail) Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
GOOGLE_USER_EMAIL=your_email@example.com
